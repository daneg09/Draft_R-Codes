  "chapter": "ch2",
  "part": "3.0 Neighbourliness",
  "element": "3.3",
  "element_title": "Street setbacks",
  "title": "Garage setback from the primary street",
  "kind": "measurable",
  "column": "C",
  "fallback_kind": "M",
  "applies_to": ["single_house"],
  "coding": ["R2-R35"],
  "region": "all",
  "inputs": ["parking.garage.setback_primary_m", "site.verge.path_or_road_offset_m", "parking.garage.parallel_parking", "parking.garage.parallel_wall_openings"],
  "evaluator": {"type": "threshold", "fact": "parking.garage.setback_primary_m", "op": ">=", "value": 5.0},
  "exceptions": [
    {"label": "footpath or road more than 1 m from boundary",
     "condition": {"type": "threshold", "fact": "site.verge.path_or_road_offset_m", "op": ">", "value": 1.0},
     "effect": {"set": {"value": 4.5}}, "inputs": ["site.verge.path_or_road_offset_m"]},
    {"label": "garage allows parallel parking",
     "condition": {"type": "composite", "mode": "all", "parts": [
       {"type": "boolean", "fact": "parking.garage.parallel_parking", "expected": true},
       {"type": "count", "fact": "parking.garage.parallel_wall_openings", "op": ">", "value": 1}]},
     "effect": {"set": {"value": 3.0}}, "inputs": ["parking.garage.parallel_parking", "parking.garage.parallel_wall_openings"]}
  ],
  "fallback": "rcodes:draft-2026-10-24/ch2/M3.3.3",
  "defined_terms": ["garage", "primary street", "street boundary", "setback"],
  "variable_by": [{"instrument": "ldp", "permission": "without-wapc", "source": "T2.5B row 3.3"},
