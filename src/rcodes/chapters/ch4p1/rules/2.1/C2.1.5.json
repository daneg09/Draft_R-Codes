  "element": "2.1",
  "element_title": "Size and layout of dwellings",
  "title": "Ceiling heights at least 2.65 m (habitable) and 2.4 m (non-habitable) (R30-R60)",
  "kind": "measurable",
  "column": "C",
  "fallback_kind": "M",
  "applies_to": [
    "multiple_dwelling"
  ],
  "coding": [
    "R30-R60"
  ],
  "region": "all",
  "text": "Measured from the finished floor level to the ceiling level, minimum ceiling heights are: i. 2.65m for habitable rooms; and ii. 2.4m for non-habitable rooms. All other ceilings are to meet the requirements of the NCC.",
  "inputs": [
    "dwellings.min.ceiling_height_habitable_m",
    "dwellings.min.ceiling_height_non_habitable_m"
  ],
  "evaluator": {
    "type": "composite",
    "mode": "all",
    "parts": [
      {
        "type": "threshold",
        "fact": "dwellings.min.ceiling_height_habitable_m",
        "op": ">=",
        "value": 2.65
      },
      {
        "type": "threshold",
        "fact": "dwellings.min.ceiling_height_non_habitable_m",
        "op": ">=",
        "value": 2.4
      }
    ]
  },
