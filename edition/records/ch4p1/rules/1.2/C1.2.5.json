  "part": "1.0 The Garden",
  "element": "1.2",
  "element_title": "Trees and landscaping",
  "title": "Shade trees for uncovered at-grade car parking: one small tree per four spaces",
  "text": "C1.2.5 Uncovered at-grade car parking to include shade trees planted at a minimum ratio of one small tree for every four car spaces, with the total number of trees to be rounded up to the nearest whole number. Note: These trees are in addition to the trees to be provided in accordance with C1.2.4.",
  "kind": "measurable",
  "column": "C",
  "fallback_kind": "M",
  "applies_to": [
    "multiple_dwelling"
  ],
  "coding": [
    "R10-R60"
  ],
  "region": "all",
  "conditions": [
    {
      "type": "count",
      "fact": "parking.uncovered_at_grade_spaces",
      "op": ">",
      "value": 0
    }
  ],
  "inputs": [
    "parking.uncovered_at_grade_spaces",
    "landscape.parking_shade_trees"
  ],
  "evaluator": {
    "type": "formula",
    "expr": "4 * landscape.parking_shade_trees",
    "op": ">=",
    "value": {
      "fact": "parking.uncovered_at_grade_spaces"
    }
  },
  "exceptions": [],
  "fallback": "rcodes:draft-2026-10-24/ch4p1/M1.2",
  "defined_terms": [
    "small tree"
  ],
